# Copy to .env and fill in. compose.yaml overrides DATABASE_URL and the S3 settings inside Docker.

# Required
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
S3_REGION=eu-central-1
S3_BUCKET_NAME=documents

# Optional (defaults shown)
# DB_ECHO=false
# POOL_SIZE=5
# POOL_MAX_OVERFLOW=10
# POOL_RECYCLE=1800
# POOL_PRE_PING=true
# JWT_EXPIRE_MINUTES=60
# PROJECT_SIZE_LIMIT_BYTES=52428800
# SENDER_EMAIL=noreply@projects.local
# FRONTEND_URL=http://localhost:8080
# INVITATION_TTL_HOURS=168

# Only for the S3 emulator (uvicorn on the host); leave unset on AWS
# S3_API_URL=http://localhost:4566
# S3_PUBLIC_URL=http://localhost:4566
# SES_API_URL=http://localhost:4566
# Read by boto3, not Settings; on AWS an IAM role provides them
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
